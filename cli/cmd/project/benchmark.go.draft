package project

// benchmark.go — `drift project benchmark`. What each function actually costs,
// and what it should therefore book.
//
// `atomic.functions[].memory` is mandatory and has no default, which is correct
// — a reservation that appears by itself is one nobody chose, and it is both the
// function's pool and its price. But it leaves a real question unanswered the
// first time someone writes a Driftfile: what number? Guessing high wastes money
// on memory nobody uses; guessing low means the pool fills and invocations are
// refused under load. Neither is discoverable by reading your own source.
//
// The platform has been measuring the answer all along. Every invocation's child
// is reaped with wait4, which carries its peak RSS; the slice keeps the
// high-water mark per function and now serves it at GET /sizing. This command is
// the other half: it asks.
//
// # Two modes, because they answer different questions
//
//	--from-slice   what your functions cost IN PRODUCTION, under real traffic,
//	               measured by the slice itself. The honest number, available
//	               only for functions that have actually run.
//	(default)      what they cost HERE, driven locally. Available before a first
//	               deploy, which is exactly when the Driftfile is being written.
//
// # Why a local measurement is trustworthy — and where it is not
//
// A slice runs a compiled function as a fresh subprocess per invocation, which
// is what this does locally: same binary, same runtime, same allocations. For
// Go, Rust, Ruby and PHP the local figure and the slice's agree closely.
//
// **Python and Node are different and the difference is large.** Those two are
// the only languages the slice runs behind a persistent language server: one
// interpreter serves every invocation, so the slice pays V8's or CPython's
// baseline ONCE. Measuring them locally, where each run is its own process,
// charges that baseline to every invocation — around 34 MiB for Node against a
// real per-invocation cost of a fraction of that. Reporting it would tell a
// tenant to book an order of magnitude too much, so this command refuses to
// guess for them and says why.
//
// Two smaller skews, both in the safe direction: the slice sets GOMEMLIMIT, so
// Go's GC holds less there than in an unconstrained local run; and the slice's
// interpreters are the image's versions, not this machine's.

import (
	"encoding/json"
	"fmt"
	"os"
	"os/exec"
	"sort"
	"strings"
	"time"

	"github.com/spf13/cobra"
)

// pooledLanguages are the languages the slice serves from a persistent language
// server rather than a subprocess per invocation (slice/src/atomic/mod.rs).
//
// The list is short and it is the whole reason this command distinguishes local
// from production measurement, so it is named here rather than inferred.
var pooledLanguages = map[string]bool{"python": true, "node": true}

// Booking grid, mirroring slice/src/atomic/admission.rs. A recommendation this
// command prints has to be a size the platform will accept.
const (
	bookingStepMiB = 8
	minBookingMiB  = 8
	maxBookingMiB  = 256
	// Headroom over the measured peak. A benchmark measures what a function DID
	// cost; a booking must cover what it will. Without margin the first
	// invocation heavier than anything the benchmark exercised is refused.
	recommendationMarginPercent = 150
)

// recommendedBookingMiB is the smallest bookable size covering peak with margin.
// Kept in lockstep with admission.rs's function of the same name — the platform
// is the authority, and a client that recommends a size the platform rounds
// differently would have the tenant write one number and be billed another.
func recommendedBookingMiB(peakBytes int64) int64 {
	if peakBytes <= 0 {
		return minBookingMiB
	}
	mib := (peakBytes*recommendationMarginPercent/100)/(1024*1024) + 1
	stepped := (mib / bookingStepMiB) * bookingStepMiB
	if stepped < mib {
		stepped += bookingStepMiB
	}
	if stepped < minBookingMiB {
		stepped = minBookingMiB
	}
	if stepped > maxBookingMiB {
		stepped = maxBookingMiB
	}
	return stepped
}

// sizingRow is one function's answer, from whichever source produced it.
type sizingRow struct {
	Function string
	Language string
	// Measurements backing the peak. Zero means NOT MEASURED, which is a
	// different finding from "measured and cheap" and must not render as one.
	Measurements int64
	PeakBytes    int64
	BookedBytes  int64
	Recommended  int64
	// Note carries why a row has no number, so an absent measurement explains
	// itself instead of appearing as a small one.
	Note string
}

// sliceSizing is the GET /sizing shape the slice serves.
type sliceSizing struct {
	BookingStepBytes int64 `json:"booking_step_bytes"`
	Functions        []struct {
		Function                 string `json:"function"`
		Measurements             int64  `json:"measurements"`
		PeakRSSBytes             int64  `json:"peak_rss_bytes"`
		BookedBytes              int64  `json:"booked_bytes"`
		RecommendedBookingBytes  int64  `json:"recommended_booking_bytes"`
		ConcurrencyAtCurrentBook int64  `json:"concurrency_at_current_booking"`
	} `json:"functions"`
}

func newBenchmarkCmd() *cobra.Command {
	var (
		fromSlice bool
		runs      int
		write     bool
	)
	cmd := &cobra.Command{
		Use:   "benchmark",
		Short: "Measure what each Atomic function costs, and what it should book",
		Long: strings.TrimSpace(`
Measure what each Atomic function costs in memory, and print the size it should
declare in its Driftfile.

By default the functions are driven locally, which works before a first deploy —
when the Driftfile is being written and the question is most pressing. With
--from-slice the numbers come from the deployed slice's own measurements of real
traffic, which is the more honest figure once there is traffic to measure.

Python and Node are reported only with --from-slice. The slice serves those two
from a persistent interpreter shared by every invocation, so a local run — one
process per invocation — measures a cost the slice does not pay.`),
		RunE: func(cmd *cobra.Command, args []string) error {
			m, err := LoadManifest("")
			if err != nil {
				return err
			}
			var rows []sizingRow
			if fromSlice {
				rows, err = benchmarkFromSlice(m)
			} else {
				rows, err = benchmarkLocally(m, runs)
			}
			if err != nil {
				return err
			}
			renderSizing(cmd.OutOrStdout(), rows, fromSlice)
			if write {
				return writeBookings(m, rows)
			}
			return nil
		},
	}
	cmd.Flags().BoolVar(&fromSlice, "from-slice", false,
		"read the deployed slice's own measurements of real traffic instead of running locally")
	cmd.Flags().IntVar(&runs, "runs", 20,
		"invocations per function when measuring locally")
	cmd.Flags().BoolVar(&write, "write", false,
		"update each function's `memory` in the Driftfile to the recommendation")
	return cmd
}

// benchmarkFromSlice asks the deployed slice what its functions have cost.
func benchmarkFromSlice(m *Manifest) ([]sizingRow, error) {
	body, err := getSliceSizing(m)
	if err != nil {
		return nil, err
	}
	var s sliceSizing
	if err := json.Unmarshal(body, &s); err != nil {
		return nil, fmt.Errorf("read the slice's sizing report: %w", err)
	}
	declared := declaredMemory(m)
	rows := make([]sizingRow, 0, len(s.Functions))
	for _, f := range s.Functions {
		r := sizingRow{
			Function:     f.Function,
			Measurements: f.Measurements,
			PeakBytes:    f.PeakRSSBytes,
			BookedBytes:  f.BookedBytes,
			Recommended:  f.RecommendedBookingBytes,
		}
		if _, ok := declared[f.Function]; !ok {
			r.Note = "not in this Driftfile"
		}
		if f.Measurements == 0 {
			r.Note = "never invoked — nothing measured"
		}
		rows = append(rows, r)
	}
	sort.Slice(rows, func(i, j int) bool { return rows[i].Function < rows[j].Function })
	return rows, nil
}

// benchmarkLocally builds and drives each function on this machine, measuring
// the peak RSS of the child that serves each invocation.
//
// The peak is taken from the OS's own accounting of the process (ru_maxrss via
// ProcessState), which is the same quantity the slice reads with wait4 — not an
// in-process estimate, which would miss the runtime's own allocations.
func benchmarkLocally(m *Manifest, runs int) ([]sizingRow, error) {
	fns := m.Slice().Nodes("atomic", "functions")
	if len(fns) == 0 {
		return nil, fmt.Errorf(
			"this Driftfile declares no functions under atomic.functions, so there is nothing to benchmark")
	}
	rows := make([]sizingRow, 0, len(fns))
	for _, fn := range fns {
		name := fn.Str("name")
		if name == "" {
			continue
		}
		dir := fn.Str("dir")
		if dir == "" {
			dir = "./atomic/" + name
		}
		lang, err := detectFunctionLanguage(dir)
		if err != nil {
			rows = append(rows, sizingRow{Function: name, Note: err.Error()})
			continue
		}
		row := sizingRow{Function: name, Language: lang}
		if pooledLanguages[lang] {
			// Refusing to print a number here is the point. A local per-process
			// measurement of a pooled language is a real number for the wrong
			// question, and a tenant cannot tell that from the table.
			row.Note = "pooled in the slice — measure with --from-slice"
			rows = append(rows, row)
			continue
		}
		peak, n, err := measureLocalPeak(dir, lang, runs)
		if err != nil {
			row.Note = err.Error()
			rows = append(rows, row)
			continue
		}
		row.PeakBytes = peak
		row.Measurements = int64(n)
		row.Recommended = recommendedBookingMiB(peak) * 1024 * 1024
		rows = append(rows, row)
	}
	sort.Slice(rows, func(i, j int) bool { return rows[i].Function < rows[j].Function })
	return rows, nil
}

// measureLocalPeak runs the function `runs` times and returns the highest peak
// RSS any single invocation reached, plus how many produced a reading.
//
// The MAXIMUM, not a mean. A function that is cheap on its common path and
// expensive on a rare one has to be booked for the rare one — a mean would size
// it for the case that never fails.
func measureLocalPeak(dir, lang string, runs int) (int64, int, error) {
	bin, cleanup, err := buildForBenchmark(dir, lang)
	if err != nil {
		return 0, 0, err
	}
	defer cleanup()

	var peak int64
	measured := 0
	envelope := `{"method":"GET","path":"/","headers":{},"body":"","query":{}}`
	for i := 0; i < runs; i++ {
		cmd := exec.Command(bin)
		cmd.Stdin = strings.NewReader(envelope)
		cmd.Stdout = nil
		cmd.Stderr = nil
		cmd.Env = append(os.Environ(), "DRIFT_RUNTIME=1")
		if err := cmd.Run(); err != nil {
			// A non-zero exit is still a completed process with valid accounting;
			// only a failure to start leaves nothing to read.
			if cmd.ProcessState == nil {
				continue
			}
		}
		if rss := peakRSSBytes(cmd); rss > 0 {
			measured++
			if rss > peak {
				peak = rss
			}
		}
	}
	if measured == 0 {
		return 0, 0, fmt.Errorf("no invocation produced a memory reading")
	}
	return peak, measured, nil
}

// renderSizing prints the table.
func renderSizing(w interface{ Write([]byte) (int, error) }, rows []sizingRow, fromSlice bool) {
	source := "measured locally"
	if fromSlice {
		source = "measured by the slice, under real traffic"
	}
	fmt.Fprintf(w, "\n  %s\n\n", source)
	fmt.Fprintf(w, "  %-24s %10s %10s %12s  %s\n", "function", "peak", "booked", "recommend", "")
	for _, r := range rows {
		peak := "—"
		if r.PeakBytes > 0 {
			peak = fmt.Sprintf("%.1f MB", float64(r.PeakBytes)/(1024*1024))
		}
		booked := "—"
		if r.BookedBytes > 0 {
			booked = fmt.Sprintf("%.0f MB", float64(r.BookedBytes)/(1024*1024))
		}
		rec := "—"
		if r.Recommended > 0 {
			rec = fmt.Sprintf("%.0f MB", float64(r.Recommended)/(1024*1024))
		}
		note := r.Note
		if note == "" && r.Measurements > 0 {
			note = fmt.Sprintf("%d measurements", r.Measurements)
		}
		fmt.Fprintf(w, "  %-24s %10s %10s %12s  %s\n", r.Function, peak, booked, rec, note)
	}
	fmt.Fprintln(w)
	fmt.Fprintln(w, "  The recommendation carries headroom over the measured peak — a booking sized")
	fmt.Fprintln(w, "  exactly to what was observed is refused by the first heavier invocation.")
	if !fromSlice {
		fmt.Fprintln(w, "  Re-run with --from-slice once deployed to size on real traffic instead.")
	}
	fmt.Fprintln(w, "  Apply these with --write.")
	fmt.Fprintln(w)
	_ = time.Now
}
